(* ::Package:: *)

(* =====================================================================
   Прогнозирование невозмущённого движения ИСЗ методом Рунге–Кутты 4-го
   порядка со стабилизацией по первым интегралам (проекционный метод).

   Wolfram Language. Реализация восстановлена по алгоритму автора.

   Двухтельное движение:  r'' = -mu r / |r|^3.
   Первые интегралы задачи Кеплера (постоянны для точного движения):
     c = r x v                       — вектор момента импульса (3 шт.),
     f = v x c - mu r/|r|            — вектор Лапласа–Рунге–Ленца (3 шт.).
   Итого 6 интегралов, I0 = {c0, f0} известны из начальных условий.

   На каждом шаге: шаг RK4; если относительное отклонение интегралов
   вышло за коридор epsilon — коррекция Гаусса–Ньютона (возврат состояния
   на многообразие интегралов), решая I(u) - I0 = 0.

   Автор идеи и реализации: Гефлинг В. И.
   ===================================================================== *)

mu = 3.9860044*^14;                                   (* грав. параметр Земли *)
u0 = {15845196., -1751586.8, 21059119.,               (* x0, y0, z0 *)
      -733.96659, 3727.3516, 862.26895};              (* vx0, vy0, vz0 *)
Tper = 43076.;                                        (* период, с *)

(* ------------------------------ Правая часть ОДУ ------------------------- *)
deriv[u_] := Module[{r = u[[1 ;; 3]], v = u[[4 ;; 6]]},
   Join[v, -mu r/Norm[r]^3]];

rk4Step[u_, dt_] := Module[{k1, k2, k3, k4},
   k1 = deriv[u];
   k2 = deriv[u + 0.5 dt k1];
   k3 = deriv[u + 0.5 dt k2];
   k4 = deriv[u + dt k3];
   u + dt/6 (k1 + 2 k2 + 2 k3 + k4)];

(* ------------------------------ Первые интегралы ------------------------- *)
firstIntegrals[u_] := Module[{r = u[[1 ;; 3]], v = u[[4 ;; 6]], c},
   c = Cross[r, v];
   Join[c, Cross[v, c] - mu r/Norm[r]]];

energy[u_] := Module[{r = u[[1 ;; 3]], v = u[[4 ;; 6]]},
   0.5 v.v - mu/Norm[r]];

(* --------------- Коррекция по интегралам (метод Гаусса–Ньютона) ---------- *)
(* Якобиан dI/du (6x6) центральными разностями *)
jacobian[u_] := Transpose@Table[
    With[{h = 1.*^-6 Max[Abs[u[[i]]], 1.]},
     (firstIntegrals[ReplacePart[u, i -> u[[i]] + h]] -
        firstIntegrals[ReplacePart[u, i -> u[[i]] - h]])/(2 h)],
    {i, 6}];

(* Возврат на многообразие интегралов: u <- u - pinv(J).(I(u)-I0).
   PseudoInverse — из-за связи |f|^2 = mu^2 + 2 E |c|^2 матрица Якоби
   вырождена по рангу; псевдообратная даёт поправку минимальной нормы. *)
project[uInit_, I0_, Iscale_] := Module[{u = uInit, g, it = 0},
   While[it < 30,
    g = firstIntegrals[u] - I0;
    If[Max[Abs[g]/Iscale] < 1.*^-12, Break[]];
    u = u - PseudoInverse[jacobian[u]].g;
    it++];
   u];

(* -------------------------------- Интегратор ----------------------------- *)
(* epsilon -> None: чистый RK4; epsilon -> число: с коррекцией.
   Возвращает {траектория (список точек {x,y,z}), макс. относит. дрейф энергии} *)
integrate[dt_, tmax_, epsilon_] := Module[
   {u = u0, I0 = firstIntegrals[u0], Iscale, e0 = energy[u0], maxd = 0., g, traj},
   Iscale = MapThread[Max, {Abs[I0], ConstantArray[1., 6]}];
   traj = Reap[
      Sow[u[[1 ;; 3]]];
      Do[
       u = rk4Step[u, dt];
       If[epsilon =!= None,
        g = firstIntegrals[u] - I0;
        If[Max[Abs[g]/Iscale] > epsilon, u = project[u, I0, Iscale]]];
       maxd = Max[maxd, Abs[energy[u] - e0]/Abs[e0]];
       Sow[u[[1 ;; 3]]],
       {Round[tmax/dt]}]][[2, 1]];
   {traj, maxd}];

(* ------------------------------- Демонстрация ---------------------------- *)
dt = 600.; nOrb = 30; eps = 1.*^-8;

{trPlain, edPlain} = integrate[dt, nOrb Tper, None];
{trProj,  edProj}  = integrate[dt, nOrb Tper, eps];

Print["Шаг dt = ", dt, " с, ", nOrb, " оборотов:"];
Print["  чистый RK4:      макс. относительный дрейф энергии = ", edPlain];
Print["  RK4 + коррекция: макс. относительный дрейф энергии = ", edProj];

(* 3D-орбита + Земля *)
Graphics3D[{
   {Blue, Line[trProj]},                                 (* орбита *)
   {Red, PointSize[0.02], Point[u0[[1 ;; 3]]]},          (* старт (перигей) *)
   {Brown, Opacity[0.6], Sphere[{0, 0, 0}, 6.371*^6]}    (* Земля *)
  },
  Axes -> True, AxesLabel -> {"x (м)", "y (м)", "z (м)"}, Boxed -> True]
